# skip amd64_sysv amd64_apple arm64 arm64_apple rv64 x86_64
# win64: by-ref aggregate temps must be 16-byte aligned

type :big = { b 17 }

export
function w $test() {
@start
	%p =l alloc4 17
	storeb 65, %p
	%r =w call $cfn(:big %p)
	ret %r
}

