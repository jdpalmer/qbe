# skip amd64_sysv amd64_apple arm64 arm64_apple rv64 x86_64
# win64: void calls must not define a return reg; a float live across
# a void call that clobbers XMM0 must be preserved

export
function d $keep(d %x) {
@start
	%y =d mul %x, %x
	call $clobberxmm0()
	ret %y
}

