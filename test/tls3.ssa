# skip amd64_sysv amd64_apple arm64 arm64_apple rv64 x86_64
# win64: thread data is per-thread (CreateThread)

thread data $v = align 4 { w 0 }

export
function w $worker(l %arg) {
@start
	storew 2, thread $v
	%r =w loadw thread $v
	ret %r
}

export
function w $test() {
@start
	storew 1, thread $v
	%h =l call $runworker()
	%main =w loadw thread $v
	%c0 =w ceqw %main, 1
	%ok =w copy %h
	%r =w and %c0, %ok
	ret %r
}

